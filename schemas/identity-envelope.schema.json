{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmd.dev/schemas/identity-envelope.schema.json",
  "title": "AgentMD Signed Identity Export Envelope",
  "type": "object",
  "required": [
    "schema_version", "agent_id", "exported_at", "record_count", "latest_version",
    "latest_receipt_hash", "signer", "records", "envelope_hash", "signature"
  ],
  "properties": {
    "schema_version": {"const": "identity-envelope.v1"},
    "agent_id": {"type": "string", "pattern": "^agentmd:[a-f0-9]{64}$"},
    "exported_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "record_count": {"type": "integer", "minimum": 1},
    "latest_version": {"type": "integer", "minimum": 1},
    "latest_receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signer": {
      "type": "object",
      "required": ["algorithm", "fingerprint", "public_key"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "public_key": {"type": "string", "minLength": 43, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "records": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object"}},
    "envelope_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {"type": "string", "minLength": 86, "maxLength": 128}
  },
  "additionalProperties": false
}
