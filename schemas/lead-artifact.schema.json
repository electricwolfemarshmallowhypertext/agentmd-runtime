{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmd.dev/schemas/lead-artifact.schema.json",
  "title": "AgentMD Lead Artifact",
  "description": "Portable input artifact for AgentMD AI Work Lead compile.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "tool",
    "task",
    "timestamp",
    "claims",
    "decisions",
    "files_touched",
    "open_loops",
    "contradictions",
    "human_approval_items",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "lead-artifact.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "claims": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "verification_status": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "anyOf": [
              {"required": ["claim"]},
              {"required": ["text"]}
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "status": {
                "type": "string"
              },
              "verification_status": {
                "type": "string"
              },
              "requires_human_approval": {
                "type": "boolean"
              }
            },
            "anyOf": [
              {"required": ["decision"]},
              {"required": ["text"]}
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "files_touched": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "open_loops": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "loop": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "item": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "status": {
                "type": "string"
              }
            },
            "anyOf": [
              {"required": ["text"]},
              {"required": ["loop"]},
              {"required": ["item"]}
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "human_approval_items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "unknown",
        "needs_human_approval",
        "contradicted",
        "partial",
        "pending",
        "failed",
        "pass",
        "fail"
      ]
    },
    "context_bundle_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "source_artifacts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "git_state": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "untracked_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
